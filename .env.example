# OCR / AI providers (swap these to change engines)
OCR_PROVIDER=textract
AI_PROVIDER=claude
AI_MODEL=claude-sonnet-4-6
AI_API_KEY=your-anthropic-api-key

# AWS (used by Textract)
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1

# MongoDB (started via: docker compose up -d)
# Password MUST match MONGO_PASSWORD used by docker-compose.yml
MONGO_URL=mongodb://uccadmin:uccSecure2024!@localhost:27017
MONGO_DB=ucc
MONGO_PASSWORD=uccSecure2024!

# Limits
MAX_FILE_SIZE_MB=50
MAX_PAGES=30
